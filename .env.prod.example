# =============================================================================
#  FARZIN — PRODUCTION muhit shabloni
#
#  ⚠️  BU FAYL SHABLON. HAQIQIY QIYMAT YOZILMAYDI VA COMMIT QILINMAYDI.
#
#      cp .env.prod.example .env.prod   →   to'ldiring   →   deploy
#
#  `.env.prod` `.gitignore` da (`.env.*`). Uni serverda yarating va
#  faqat root o'qiy oladigan qiling:  chmod 600 .env.prod
#
#  To'liq yo'riqnoma: docs/runbooks/deploy.md
# =============================================================================

# --- Tashqi portlar (BITTA SERVERDA KO'P LOYIHA) --------------------------
#  Bu portlar 127.0.0.1 ga bog'lanadi — internetga chiqish reverse proxy
#  orqali. BAND BO'LMAGAN portni tanlang:
#      ss -tlnp | grep -E ':(3100|3101)\b'
FARZIN_API_PORT=3100
FARZIN_WEB_PORT=3101

# --- Ma'lumotlar bazasi ---------------------------------------------------
#  Parol: openssl rand -base64 32
#  ⚠️  DATABASE_URL dagi host — `postgres` (konteyner nomi), `localhost` EMAS.
POSTGRES_USER=farzin
POSTGRES_PASSWORD=
POSTGRES_DB=farzin
DATABASE_URL=postgresql://farzin:PAROLNI_SHU_YERGA@postgres:5432/farzin?schema=public
POSTGRES_MAX_CONNECTIONS=100

# --- Redis ----------------------------------------------------------------
#  openssl rand -base64 32
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Ommaviy manzillar ----------------------------------------------------
#  APP_URL — email xatlaridagi havolalar shu manzil bilan quriladi
#  (parolni tiklash, emailni tasdiqlash). Noto'g'ri bo'lsa xatlar
#  ishlamaydigan havola bilan ketadi.
APP_URL=https://farzin.uz
#  PUBLIC_API_URL — brauzer WebSocket ulanishi shu manzilga boradi.
#  ⚠️  BUILD VAQTIDA bundle ichiga yoziladi — o'zgarsa `web` image
#      QAYTA QURILISHI kerak.
PUBLIC_API_URL=https://api.farzin.uz
#  Vergul bilan: frontend qaysi domendan API'ga murojaat qiladi.
CORS_ORIGINS=https://farzin.uz

# --- JWT ------------------------------------------------------------------
#  Har biri ALOHIDA:  openssl rand -base64 64
#  ⚠️  configuration.ts prod'da shablon/zaif kalitni (CHANGE_ME, secret,
#      password) RAD ETADI — ilova ishga TUSHMAYDI.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- TOTP 2FA -------------------------------------------------------------
#  AYNAN 64 hex belgi:  openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# --- Argon2id -------------------------------------------------------------
#  ⚠️  Bu qiymatlar TAXMINIY va PROD HARDWARE'da o'lchanishi kerak.
#      Maqsad — bitta hash ~50-100 ms. Juda past bo'lsa parol himoyasi
#      zaiflashadi, juda yuqori bo'lsa login sekinlashadi.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Email (SMTP) ---------------------------------------------------------
#  ⚠️  SMTP_HOST bo'lmasa ilova ISHLAYDI, lekin tasdiqlash va parol
#      tiklash xatlari YUBORILMAYDI (log'da ogohlantirish chiqadi).
#      Ya'ni yangi foydalanuvchi emailini tasdiqlay olmaydi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@farzin.uz

# --- Object storage (S3-mos) ----------------------------------------------
#  Avatar, PGN arxiv, hisobotlar. Hozircha ixtiyoriy.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=farzin
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- Fair play ------------------------------------------------------------
#  STOCKFISH_PATH worker image'ida allaqachon o'rnatilgan
#  (/usr/bin/stockfish) — bu yerda qayta berish shart emas.
FAIRPLAY_SAMPLING_RATE=0.05
FAIRPLAY_ENGINE_DEPTH=12
FAIRPLAY_SUSPICION_THRESHOLD=0.6

# --- Reyting --------------------------------------------------------------
#  ⚠️  τ (tau) qiymati YAKUNIY EMAS — real ma'lumotda backtest kerak.
GLICKO2_TAU=0.5
GLICKO2_DEFAULT_RATING=1500
GLICKO2_DEFAULT_RD=350
GLICKO2_DEFAULT_VOLATILITY=0.06

# --- Kuzatuv --------------------------------------------------------------
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_SERVICE_NAME=farzin-api
#  ⚠️  BERILMASA /metrics AUTENTIFIKATSIYASIZ ochiq qoladi. U route
#      inventari, so'rov hajmi, xato darajasi va ledger holatini
#      oshkor qiladi.  openssl rand -base64 48
METRICS_TOKEN=

SENTRY_DSN=

# --- Rate limiting --------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# --- To'lov (HALI ULANMAGAN — docs/09) ------------------------------------
#  Provayderlar stub holatida: kalit berilmasa to'lov yo'li toza
#  o'chirilgan bo'ladi (provider-gating).
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true
