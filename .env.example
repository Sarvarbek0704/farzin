# =============================================================================
#  FARZIN — muhit o'zgaruvchilari SHABLONI
#
#  ⚠️  BU FAYL SHABLON. HAQIQIY QIYMAT YOZILMAYDI.
#
#  Ishlatish:  cp .env.example .env  →  keyin .env ni to'ldiring
#  .env FAYLI HECH QACHON COMMIT QILINMAYDI (.gitignore da).
#
#  Eslatma: loyihaning oldingi versiyasida DB paroli va JWT kalitlari
#  config/default.json ichida GitHub'ga commit qilingan edi. Bu takrorlanmaydi.
#  Batafsil: docs/10-security.md §8
#
#  Prod'da .env ishlatilmaydi — sirlar Vault/Doppler/AWS Secrets Manager'dan.
# =============================================================================

# --- Ilova ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Ma'lumotlar bazasi --------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://farzin:CHANGE_ME@localhost:5432/farzin?schema=public

# --- Redis ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT -----------------------------------------------------------------
# Generatsiya:  openssl rand -base64 64
# ⚠️  Har muhit uchun ALOHIDA kalit. Dev kaliti prod'da ishlatilmaydi.
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_64
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_ACCESS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- TOTP 2FA (docs/10-security.md §2.5) ----------------------------------
# TOTP sirlari DB'da SHIFRLANGAN holda saqlanadi (AES-256-GCM).
# Generatsiya:  openssl rand -hex 32   (aynan 64 hex belgi)
TOTP_ENCRYPTION_KEY=

# --- Argon2id (docs/adr/0004-argon2id-over-bcrypt.md) --------------------
# ⚠️  Bu qiymatlar TAXMINIY. Prod hardware'da benchmark qilinishi kerak.
#     Maqsad: bitta hash ~50-100ms.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Object storage (S3-mos) ---------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=farzin-dev
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# --- To'lov provayderlari ------------------------------------------------
# ⚠️  Sandbox kalitlari. Rasmiy hujjat: docs.click.uz / developer.help.paycom.uz
# ⚠️  Bu integratsiyalar hali implementatsiya qilinmagan — docs/09-payments-and-billing.md
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true

UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# --- Xabarnomalar --------------------------------------------------------
# Eskiz.uz — O'zbekistonda SMS
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

TELEGRAM_BOT_TOKEN=

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@farzin.uz

# --- OAuth ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Fair play (docs/08-fair-play.md) ------------------------------------
# STOCKFISH_PATH IXTIYORIY: berilmasa engine korrelyatsiya TOZA o'chirilgan
# (provider-gating), vaqt tahlili ishlayveradi.
# STOCKFISH_PATH=/usr/local/bin/stockfish
# Tanlab tahlil ulushi (docs/08 §8.2 — hamma o'yin EMAS)
FAIRPLAY_SAMPLING_RATE=0.05
# `go depth N` — determinizm uchun (docs/08 §10); LOW byudjetga mos default
FAIRPLAY_ENGINE_DEPTH=12
# suspicionScore chegarasi — ish komissiyaga KO'RINADI (jazo YO'Q, §4.1)
FAIRPLAY_SUSPICION_THRESHOLD=0.6

# --- Reyting (docs/06-rating-system.md) ----------------------------------
# ⚠️  τ (tau) qiymati YAKUNIY EMAS. Real ma'lumotda backtest kerak.
#     Glickman tavsiyasi: 0.3–1.2
GLICKO2_TAU=0.5
GLICKO2_DEFAULT_RATING=1500
GLICKO2_DEFAULT_RD=350
GLICKO2_DEFAULT_VOLATILITY=0.06

# --- Kuzatuv -------------------------------------------------------------
LOG_LEVEL=debug
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=farzin-api
SENTRY_DSN=

# --- Rate limiting (docs/04-api-spec.md §6) ------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=300
